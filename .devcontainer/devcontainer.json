{
  "name": "js_Learn",
  "image": "mcr.microsoft.com/vscode/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
				"vscode-icons-team.vscode-icons",
				"wayou.vscode-todo-highlight"
      ],
      "settings": {
				"editor.fontSize": 32,
				"terminal.integrated.fontSize": 24,
				"editor.wordWrap": "on"
      }
      
    }
  }
}